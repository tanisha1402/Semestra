# Placeholders only. Never commit real keys. Copy to .env for local use.
PORT=4000
AI_PROVIDER=ollama            # ollama (local) or gemini (hosted Gemma via Google AI Studio)

# Local model
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b

# Hosted Gemma (production). Set GEMINI_API_KEY in the host's secret settings, never in code.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Production only (set on the host)
# NODE_ENV=production
# RATE_LIMIT_MAX=60           # AI requests per IP per 10 minutes
# ALLOWED_ORIGIN=             # only if the page is served from a different origin than the API
# HOST=0.0.0.0                # default in production; 127.0.0.1 otherwise
